{
  "format_version": "1.26.0",
  "minecraft:block": {
    "description": {
      "identifier": "ropes:rope",
      "menu_category": {
        "category": "nature"
      },
      "states": {
        "ropes:rope_state": ["coiled", "segment", "whip_handle"],
        "ropes:face": ["up", "down", "north", "south", "east", "west"]
      }
    },
    "components": {
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0.5
      },
      "minecraft:collision_box": false,
      "minecraft:selection_box": {
        "origin": [-1, 0, -1],
        "size": [2, 16, 2]
      },
      "minecraft:geometry": "geometry.ropes.rope",
      "minecraft:material_instances": {
        "*": {
          "texture": "ropes_rope_segment",
          "render_method": "alpha_test"
        }
      },
      "minecraft:light_dampening": 0,
      "ropes:rope_component": {}
    },
    "permutations": [
      {
        "condition": "q.block_state('ropes:rope_state') == 'coiled'",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "ropes_rope_coil",
              "render_method": "alpha_test"
            }
          }
        }
      },
      {
        "condition": "q.block_state('ropes:rope_state') == 'whip_handle'",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "ropes_whip_handle",
              "render_method": "alpha_test"
            }
          }
        }
      },
      {
        "condition": "q.block_state('ropes:face') == 'north'",
        "components": {
          "minecraft:geometry": "geometry.ropes.rope_wall",
          "minecraft:selection_box": {
            "origin": [-1, 0, 5],
            "size": [2, 16, 2]
          }
        }
      },
      {
        "condition": "q.block_state('ropes:face') == 'south'",
        "components": {
          "minecraft:geometry": "geometry.ropes.rope_wall",
          "minecraft:selection_box": {
            "origin": [-1, 0, 5],
            "size": [2, 16, 2]
          },
          "minecraft:transformation": { "rotation": [0, 180, 0] }
        }
      },
      {
        "condition": "q.block_state('ropes:face') == 'east'",
        "components": {
          "minecraft:geometry": "geometry.ropes.rope_wall",
          "minecraft:selection_box": {
            "origin": [-1, 0, 5],
            "size": [2, 16, 2]
          },
          "minecraft:transformation": { "rotation": [0, 270, 0] }
        }
      },
      {
        "condition": "q.block_state('ropes:face') == 'west'",
        "components": {
          "minecraft:geometry": "geometry.ropes.rope_wall",
          "minecraft:selection_box": {
            "origin": [-1, 0, 5],
            "size": [2, 16, 2]
          },
          "minecraft:transformation": { "rotation": [0, 90, 0] }
        }
      }
    ]
  }
}
